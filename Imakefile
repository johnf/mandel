
#####  C++ COMPILER
#CXX         = g++

#####  C COMPILER
CC          = gcc

#######################################################################

.SUFFIXES: .C $(SUFFIXES)

SRCS = mand.c xmand.c  # Source names here.

EXTRA_WARN_FLAGS = -Wduplicated-cond -Wduplicated-branches -Wlogical-op -Wrestrict -Wnull-dereference -Wjump-misses-init -Wdouble-promotion -Wshadow -Wformat=2
CCOPTIONS = -O2 -Wall -Wextra $(EXTRA_WARN_FLAGS) -D_DEFAULT_SOURCE

LOCAL_LIBRARIES = $(XLIB)

EXTRA_LOAD_FLAGS= -lm

OBJS = $(SRCS:.c=.o) 

.DEFAULT: XMand

XMand: $(OBJS)
	$(RM) $@
	$(CC) -o $@ $(OBJS) $(LDOPTIONS) $(LOCAL_LIBRARIES) $(LDLIBS) $(EXTRA_LOAD_FLAGS)

CleanTarget()

.c.o:
	$(CC) $(CFLAGS) -c $< -o $@


clean::
	$(RM) XMand *.o  #ccc = name of prog here too.
